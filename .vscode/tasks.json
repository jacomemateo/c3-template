{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C3: Run",
            "type": "shell",
            "command": "c3c",
            "args": ["run"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "C3: Build Debug",
            "type": "shell",
            "command": "c3c",
            "args": ["build", "debug"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "C3: Build Release",
            "type": "shell",
            "command": "c3c",
            "args": ["build", "release"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "C3: Clean Workspace",
            "type": "shell",
            "command": "rm -rf bin/ build/ .c3_lib c3lsp.json .direnv/",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            }
        }
    ]
}